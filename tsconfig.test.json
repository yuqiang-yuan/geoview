{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "moduleResolution": "bundler",
        "module": "ESNext",
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["vitest/globals", "node"],
        "skipLibCheck": true
    },
    "include": ["test/**/*.ts", "vitest.config.ts", "src/**/*.ts"]
}
